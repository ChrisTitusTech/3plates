POSTGRES_DB=3plates
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/3plates
API_PORT=3000
API_HOST=0.0.0.0
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
AUTH_SECRET=replace-me
AUTH_BASE_URL=http://localhost:3000
# Additional exact client callbacks, comma-separated; no query, fragment, or credentials.
# Example for Expo Go: exp://192.168.1.10:8081/--/auth/callback
AUTH_REDIRECT_URLS=
AUTH_GOOGLE_CLIENT_ID=replace-me
AUTH_GOOGLE_CLIENT_SECRET=replace-me
AUTH_APPLE_CLIENT_ID=replace-me
AUTH_APPLE_TEAM_ID=replace-me
AUTH_APPLE_KEY_ID=replace-me
AUTH_APPLE_PRIVATE_KEY=
AUTH_APPLE_PRIVATE_KEY_PATH=
AUTH_SESSION_TTL_DAYS=30
ADMIN_API_KEY=replace-me-admin-key

# Optional unified WHOOP integration. Configure all four together; use the
# existing Gallant database and encryption key to retain history and tokens.
# These are server-only settings. Never prefix them with EXPO_PUBLIC_.
WHOOP_DATABASE_URL=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_TOKEN_KEY=
WHOOP_PUBLIC_URL=https://whoop.3spinningplates.com
